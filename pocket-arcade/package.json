    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "~7.6.11",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
